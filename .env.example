# EmailJS settings for the contact form (https://www.emailjs.com).
# Copy this file to .env.local and fill in the values from your EmailJS dashboard.
# .env.local is gitignored. CRA bakes these into the build, so set them before `npm run deploy`.
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=
